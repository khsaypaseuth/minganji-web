# Copy to .env.local and fill in. Never commit real values.

# --- AI assistant (server-side only) ---------------------------------------
# Without this key the assistant runs in a clearly labelled FAQ mode.
ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5. For lower cost: claude-haiku-5-5
CHAT_MODEL=

# --- Contact form delivery ------------------------------------------------
# Any endpoint that accepts a JSON POST (Formspree, Make, Zapier, n8n, CRM…).
# Without it the form says plainly that nothing was sent and offers email.
CONTACT_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <token>".
CONTACT_WEBHOOK_TOKEN=

# --- Site ------------------------------------------------------------------
# Canonical origin used for metadata (default https://minganji.ai)
NEXT_PUBLIC_SITE_URL=
